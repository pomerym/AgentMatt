{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Providers Configuration Schema",
  "type": "object",
  "required": ["provider", "providers"],
  "properties": {
    "provider": {
      "type": "string",
      "description": "Active provider name",
      "enum": ["copilot", "aws_bedrock"]
    },
    "providers": {
      "type": "object",
      "description": "Provider configurations",
      "properties": {
        "copilot": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Whether Copilot is enabled"
            },
            "api_key": {
              "type": "string",
              "description": "GitHub Copilot API key"
            }
          },
          "additionalProperties": false
        },
        "aws_bedrock": {
          "type": "object",
          "required": ["enabled", "region", "model_id"],
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Whether AWS Bedrock is enabled"
            },
            "region": {
              "type": "string",
              "description": "AWS region"
            },
            "access_key_id": {
              "type": "string",
              "description": "AWS access key ID"
            },
            "secret_access_key": {
              "type": "string",
              "description": "AWS secret access key"
            },
            "session_token": {
              "type": "string",
              "description": "AWS session token (optional)"
            },
            "model_id": {
              "type": "string",
              "description": "Bedrock model ID"
            },
            "inference_profile_id": {
              "type": "string",
              "description": "Inference profile ID or ARN for models that require provisioned throughput"
            },
            "anthropic_version": {
              "type": "string",
              "description": "Anthropic API version for Bedrock"
            },
            "max_tokens": {
              "type": "integer",
              "minimum": 1,
              "default": 4096
            },
            "temperature": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0,
              "default": 0.7
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
