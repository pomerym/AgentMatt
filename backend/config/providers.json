{
	"provider": "aws_bedrock",
	"providers": {
		"copilot": {
			"enabled": false,
			"api_key": "${COPILOT_API_KEY}"
		},
		"aws_bedrock": {
			"enabled": true,
			"region": "ca-central-1",
			"access_key_id": "${AWS_ACCESS_KEY_ID}",
			"secret_access_key": "${AWS_SECRET_ACCESS_KEY}",
			"session_token": "${AWS_SESSION_TOKEN}",
			"model_id": "anthropic.claude-opus-4-5-20251101-v1:0",
			"max_tokens": 4096,
			"temperature": 0.7
		}
	}
}
