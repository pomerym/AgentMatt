{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Server Configuration Schema",
  "type": "object",
  "required": ["host", "port"],
  "properties": {
    "host": {
      "type": "string",
      "description": "Server host address",
      "default": "localhost"
    },
    "port": {
      "type": "integer",
      "description": "Server port number",
      "minimum": 1024,
      "maximum": 65535,
      "default": 8000
    },
    "database": {
      "type": "string",
      "description": "Database file path",
      "default": "agno_agent.db"
    },
    "log_level": {
      "type": "string",
      "enum": ["debug", "info", "warning", "error"],
      "description": "Logging level",
      "default": "info"
    },
    "mcp": {
      "type": "object",
      "description": "MCP server configuration",
      "properties": {
        "tool_cache_ttl": {
          "type": "integer",
          "description": "Seconds to cache tool lists",
          "default": 30
        },
        "servers": {
          "type": "array",
          "description": "Configured MCP servers",
          "items": {
            "type": "object",
            "required": ["id", "transport"],
            "properties": {
              "id": {"type": "string"},
              "name": {"type": "string"},
              "transport": {"type": "string", "enum": ["stdio", "http"]},
              "command": {"type": "string"},
              "args": {"type": "array", "items": {"type": "string"}},
              "cwd": {"type": "string"},
              "env": {
                "type": "object",
                "additionalProperties": {"type": "string"}
              },
              "url": {"type": "string"},
              "headers": {
                "type": "object",
                "additionalProperties": {"type": "string"}
              },
              "verify_ssl": {
                "type": "boolean",
                "description": "Whether to verify SSL certificates for HTTPS connections (default: true)",
                "default": true
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
